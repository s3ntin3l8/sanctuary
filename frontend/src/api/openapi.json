          },
          "doc_count": {
            "title": "Doc Count",
            "type": "integer"
          },
          "doc_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Doc Id"
          },
          "kind": {
            "enum": [
              "doc",
              "batch"
