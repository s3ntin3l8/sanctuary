{
  "components": {
    "schemas": {
      "ActionItemType": {
        "description": "Type of action derived from a document.",
        "enum": [
          "deadline",
          "court_date",
          "response_required",
          "filing_required",
          "payment_due"
        ],
        "title": "ActionItemType",
        "type": "string"
      },
      "AuthConfig": {
        "description": "What the public sign-in screens need to know before anyone is logged in.",
        "properties": {
          "first_run": {
            "title": "First Run",
            "type": "boolean"
          },
          "oidc_enabled": {
            "title": "Oidc Enabled",
            "type": "boolean"
          },
          "oidc_provider_name": {
            "title": "Oidc Provider Name",
            "type": "string"
          },
          "signup_enabled": {
            "title": "Signup Enabled",
            "type": "boolean"
          }
        },
        "required": [
          "first_run",
          "signup_enabled",
          "oidc_enabled",
          "oidc_provider_name"
        ],
        "title": "AuthConfig",
        "type": "object"
      },
      "CaseCard": {
        "description": "One case as shown on Home and in the Cases directory.",
        "properties": {
          "client_name": {
            "title": "Client Name",
            "type": "string"
          },
          "days_since_activity": {
            "title": "Days Since Activity",
            "type": "integer"
          },
          "doc_count": {
            "title": "Doc Count",
            "type": "integer"
          },
          "exposure_eur": {
            "title": "Exposure Eur",
            "type": "number"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "is_dormant": {
            "title": "Is Dormant",
            "type": "boolean"
          },
          "is_draft": {
            "title": "Is Draft",
            "type": "boolean"
          },
          "last_activity_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Activity At"
          },
          "matter_type": {
            "title": "Matter Type",
            "type": "string"
          },
          "max_significance": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SignificanceTier"
              },
              {
                "type": "null"
              }
            ]
          },
          "new_docs": {
            "title": "New Docs",
            "type": "integer"
          },
          "next_action": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NextAction"
              },
              {
                "type": "null"
              }
            ]
          },
          "open_action_count": {
            "title": "Open Action Count",
            "type": "integer"
          },
          "opposing_party": {
            "title": "Opposing Party",
            "type": "string"
          },
          "pending_close": {
            "title": "Pending Close",
            "type": "boolean"
          },
          "proceeding_name": {
            "title": "Proceeding Name",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/CaseStatus"
          },
          "status_label": {
            "title": "Status Label",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "status_label",
          "is_draft",
          "pending_close",
          "client_name",
          "opposing_party",
          "proceeding_name",
          "matter_type",
          "next_action",
          "exposure_eur",
          "doc_count",
          "open_action_count",
          "new_docs",
          "days_since_activity",
          "is_dormant",
          "max_significance",
          "last_activity_at"
        ],
        "title": "CaseCard",
        "type": "object"
      },
      "CaseCreate": {
        "properties": {
          "case_id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$",
            "title": "Case Id",
            "type": "string"
          },
          "court_name": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Court Name",
            "type": "string"
          },
          "jurisdiction": {
            "$ref": "#/components/schemas/Jurisdiction",
            "default": "de"
          },
          "title": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "case_id",
          "title",
          "court_name"
        ],
        "title": "CaseCreate",
        "type": "object"
      },
      "CaseCreated": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "title": "CaseCreated",
        "type": "object"
      },
      "CaseStatus": {
        "enum": [
          "intake",
          "discovery",
          "pre_trial",
          "trial",
          "post_trial",
          "closed"
        ],
        "title": "CaseStatus",
        "type": "string"
      },
      "CasesDirectory": {
        "properties": {
          "cases": {
            "items": {
              "$ref": "#/components/schemas/CaseCard"
            },
            "title": "Cases",
            "type": "array"
          },
          "counts_by_status": {
            "additionalProperties": {
              "type": "integer"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/CaseStatus"
            },
            "title": "Counts By Status",
            "type": "object"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "cases",
          "counts_by_status",
          "total"
        ],
        "title": "CasesDirectory",
        "type": "object"
      },
      "CurrentUser": {
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          }
        },
        "required": [
          "id",
          "email",
          "display_name",
          "role"
        ],
        "title": "CurrentUser",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Body of every non-2xx ``/api/v1`` response.\n\n``code`` is a stable machine-readable identifier the client branches on;\n``detail`` is the human-readable message it may show as-is.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail",
          "code"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "FailedDoc": {
        "properties": {
          "batch_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Batch Id"
          },
          "doc_id": {
            "title": "Doc Id",
            "type": "integer"
          },
          "error": {
            "title": "Error",
            "type": "string"
          },
          "stage": {
            "title": "Stage",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "doc_id",
          "batch_id",
          "title",
          "stage",
          "error"
        ],
        "title": "FailedDoc",
        "type": "object"
      },
      "HomeActionItem": {
        "properties": {
          "action_type": {
            "$ref": "#/components/schemas/ActionItemType"
          },
          "case_id": {
            "title": "Case Id",
            "type": "string"
          },
          "case_title": {
            "title": "Case Title",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "due_date": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due Date"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "case_id",
          "case_title",
          "title",
          "description",
          "due_date",
          "action_type"
        ],
        "title": "HomeActionItem",
        "type": "object"
      },
      "HomeDeltaCase": {
        "properties": {
          "case_id": {
            "title": "Case Id",
            "type": "string"
          },
          "case_title": {
            "title": "Case Title",
            "type": "string"
          },
          "doc_titles": {
            "items": {
              "type": "string"
            },
            "title": "Doc Titles",
            "type": "array"
          },
          "max_significance": {
            "$ref": "#/components/schemas/SignificanceTier"
          },
          "new_actions": {
            "title": "New Actions",
            "type": "integer"
          },
          "new_doc_count": {
            "title": "New Doc Count",
            "type": "integer"
          }
        },
        "required": [
          "case_id",
          "case_title",
          "new_doc_count",
          "new_actions",
          "max_significance",
          "doc_titles"
        ],
        "title": "HomeDeltaCase",
        "type": "object"
      },
      "HomeSignal": {
        "properties": {
          "action": {
            "title": "Action",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "link": {
            "title": "Link",
            "type": "string"
          },
          "severity": {
            "title": "Severity",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "severity",
          "title",
          "detail",
          "action",
          "link"
        ],
        "title": "HomeSignal",
        "type": "object"
      },
      "HomeTriageBundle": {
        "properties": {
          "case_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Case Id"
          },
          "doc_count": {
            "title": "Doc Count",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "pipeline": {
            "$ref": "#/components/schemas/PipelineCounts"
          },
          "received_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Received At"
          },
          "sender_email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sender Email"
          },
          "status": {
            "$ref": "#/components/schemas/IngestBatchStatus"
          },
          "suggested_case_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Suggested Case Id"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "received_at",
          "sender_email",
          "title",
          "doc_count",
          "case_id",
          "suggested_case_id",
          "pipeline"
        ],
        "title": "HomeTriageBundle",
        "type": "object"
      },
      "HomeView": {
        "properties": {
          "active_cases": {
            "items": {
              "$ref": "#/components/schemas/CaseCard"
            },
            "title": "Active Cases",
            "type": "array"
          },
          "caught_up": {
            "title": "Caught Up",
            "type": "boolean"
          },
          "delta_cases": {
            "items": {
              "$ref": "#/components/schemas/HomeDeltaCase"
            },
            "title": "Delta Cases",
            "type": "array"
          },
          "draft_cases": {
            "items": {
              "$ref": "#/components/schemas/CaseCard"
            },
            "title": "Draft Cases",
            "type": "array"
          },
          "greeting": {
            "title": "Greeting",
            "type": "string"
          },
          "last_home_visit": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Home Visit"
          },
          "now": {
            "format": "date-time",
            "title": "Now",
            "type": "string"
          },
          "signals": {
            "items": {
              "$ref": "#/components/schemas/HomeSignal"
            },
            "title": "Signals",
            "type": "array"
          },
          "today_items": {
            "items": {
              "$ref": "#/components/schemas/HomeActionItem"
            },
            "title": "Today Items",
            "type": "array"
          },
          "triage_bundles": {
            "items": {
              "$ref": "#/components/schemas/HomeTriageBundle"
            },
            "title": "Triage Bundles",
            "type": "array"
          },
          "user_name": {
            "title": "User Name",
            "type": "string"
          }
        },
        "required": [
          "greeting",
          "user_name",
          "now",
          "today_items",
          "triage_bundles",
          "last_home_visit",
          "delta_cases",
          "signals",
          "draft_cases",
          "active_cases",
          "caught_up"
        ],
        "title": "HomeView",
        "type": "object"
      },
      "IngestBatchStatus": {
        "enum": [
          "pending",
          "processing",
          "completed",
          "failed",
          "dismissed",
          "awaiting_slicing"
        ],
        "title": "IngestBatchStatus",
        "type": "string"
      },
      "Jurisdiction": {
        "description": "Case jurisdiction for cost system.",
        "enum": [
          "de",
          "uk",
          "us",
          "other"
        ],
        "title": "Jurisdiction",
        "type": "string"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "next": {
            "default": "/",
            "title": "Next",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "NextAction": {
        "properties": {
          "action_type": {
            "$ref": "#/components/schemas/ActionItemType"
          },
          "due_date": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due Date"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "due_date",
          "action_type"
        ],
        "title": "NextAction",
        "type": "object"
      },
      "PipelineCounts": {
        "properties": {
          "completed": {
            "title": "Completed",
            "type": "integer"
          },
          "failed": {
            "title": "Failed",
            "type": "integer"
          },
          "pending": {
            "title": "Pending",
            "type": "integer"
          },
          "running": {
            "title": "Running",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "total",
          "running",
          "pending",
          "failed",
          "completed"
        ],
        "title": "PipelineCounts",
        "type": "object"
      },
      "PipelineStage": {
        "enum": [
          "extract",
          "metadata",
          "batch_analysis",
          "enrich",
          "relationships",
          "claims",
          "entities",
          "embeddings"
        ],
        "title": "PipelineStage",
        "type": "string"
      },
      "QueueCounts": {
        "properties": {
          "ai_inflight": {
            "title": "Ai Inflight",
            "type": "integer"
          },
          "executing": {
            "title": "Executing",
            "type": "integer"
          },
          "failed": {
            "title": "Failed",
            "type": "integer"
          },
          "queued": {
            "title": "Queued",
            "type": "integer"
          }
        },
        "required": [
          "executing",
          "queued",
          "failed",
          "ai_inflight"
        ],
        "title": "QueueCounts",
        "type": "object"
      },
      "QueueItem": {
        "properties": {
          "batch_id": {
            "anyOf": [
              {
