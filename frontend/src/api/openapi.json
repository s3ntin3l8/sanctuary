        "description": "Document significance to case \u2014 drives graph visibility.",
        "enum": [
          "critical",
          "significant",
          "informational",
          "administrative"
        ],
        "title": "SignificanceTier",
        "type": "string"
      },
      "SignupRequest": {
        "properties": {
          "display_name": {
            "default": "",
