            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          },
          "password_confirm": {
            "title": "Password Confirm",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "password_confirm"
