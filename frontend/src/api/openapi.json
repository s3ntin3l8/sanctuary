            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "stage": {
            "$ref": "#/components/schemas/PipelineStage"
          }
        },
        "required": [
          "kind",
          "stage",
          "label",
          "doc_id",
          "batch_id",
          "doc_count"
        ],
        "title": "QueueItem",
        "type": "object"
      },
      "QueueView": {
        "properties": {
          "counts": {
            "$ref": "#/components/schemas/QueueCounts"
          },
          "executing": {
            "items": {
              "$ref": "#/components/schemas/QueueItem"
            },
            "title": "Executing",
            "type": "array"
          },
          "failed": {
            "items": {
              "$ref": "#/components/schemas/FailedDoc"
            },
            "title": "Failed",
            "type": "array"
          },
          "queued": {
            "items": {
              "$ref": "#/components/schemas/QueueItem"
            },
            "title": "Queued",
