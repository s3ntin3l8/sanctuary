{
  "components": {
    "schemas": {
      "AuthConfig": {
        "description": "What the public sign-in screens need to know before anyone is logged in.",
        "properties": {
          "first_run": {
            "title": "First Run",
            "type": "boolean"
          },
          "oidc_enabled": {
            "title": "Oidc Enabled",
            "type": "boolean"
          },
          "oidc_provider_name": {
            "title": "Oidc Provider Name",
            "type": "string"
          },
          "signup_enabled": {
            "title": "Signup Enabled",
            "type": "boolean"
          }
        },
        "required": [
          "first_run",
          "signup_enabled",
          "oidc_enabled",
          "oidc_provider_name"
        ],
        "title": "AuthConfig",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Body of every non-2xx ``/api/v1`` response.\n\n``code`` is a stable machine-readable identifier the client branches on;\n``detail`` is the human-readable message it may show as-is.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail",
          "code"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "next": {
            "default": "/",
            "title": "Next",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "SessionStarted": {
        "description": "A session cookie was set; ``next`` is the same-site path to navigate to.",
        "properties": {
          "next": {
            "title": "Next",
            "type": "string"
          }
        },
        "required": [
          "next"
        ],
        "title": "SessionStarted",
        "type": "object"
      },
      "SignupRequest": {
        "properties": {
          "display_name": {
            "default": "",
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          },
          "password_confirm": {
            "title": "Password Confirm",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "password_confirm"
        ],
        "title": "SignupRequest",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Sanctuary API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/config": {
      "get": {
        "operationId": "auth_config_api_v1_auth_config_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthConfig"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Auth Config",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionStarted"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/signup": {
      "post": {
        "operationId": "signup_api_v1_auth_signup_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionStarted"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Signup",
        "tags": [
          "auth"
        ]
      }
    }
  }
}
